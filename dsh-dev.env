# MP-V6 dsh-web 本机开发配置 ── REFERENCE ONLY (不要再 cp 到 .env)
#
# ⚠️  这个文件不是 dsh 的 .env, 也别再 `cp dsh-dev.env vendor/.../.env`.
#
# dsh 的 loader 把 'DSH_' 列为 BOOTSTRAP_PREFIX (vendor/deepseek-harness/packages/
# boot/app-boot/src/index.ts:117), 任何 .env 里的 DSH_* 都会被拒绝并抛错:
#   "DSH_CACHE ... only the launching environment may set ...; export DSH_CACHE
#    instead of putting it in a .env file"
#
# ─────────────────────────────────────────────────────────────────────────
#  真正的启动入口: scripts/dev/dsh-web.sh
#      DSH_DEEPSEEK_API_KEY=sk-xxx ./scripts/dev/dsh-web.sh
#  覆盖任何默认值: 调用前 inline export 即可
#      DSH_LLM_PROVIDER=openai DSH_DEEPSEEK_API_KEY=sk-xxx ./scripts/dev/dsh-web.sh
# ─────────────────────────────────────────────────────────────────────────
#
# 下面各组 "DSH_X=Y" 都是 [dsh-web.sh] 里 export 默认值的清单, 用作查档.
# 改默认值请直接改 dsh-web.sh, 别动这文件 (这文件进来就给 gitignore 拦了).

# ── dsh runtime ──────────────────────────────────────────────────────────
# DSH_HOME        vendor/deepseek-harness/.dsh-data
# DSH_CACHE       vendor/deepseek-harness/.dsh-cache
# DSH_CONFIG      vendor/deepseek-harness/.dsh-config

# ── Supabase local (54321, dev keys 是 supabase status 默认值, 不是 secrets) ─
# DSH_SUPABASE_URL       http://localhost:54321
# DSH_SUPABASE_KEY       <service-role-jwt>
# DSH_SUPABASE_ANON_KEY  <anon-jwt>

# ── Postgres direct (Supabase 自带 PG, 54322) ────────────────────────────
# DSH_PG_HOST=localhost
# DSH_PG_PORT=54322
# DSH_PG_USER=postgres
# DSH_PG_PASSWORD=postgres
# DSH_PG_DATABASE=postgres
# DSH_PG_SCHEMA=public

# ── LLM provider (DSH_DEEPSEEK_API_KEY 必填) ─────────────────────────────
# DSH_LLM_PROVIDER       deepseek-primary
# DSH_DEEPSEEK_API_KEY   (必填, 走 shell export)
# DSH_DEEPSEEK_BASE_URL  https://api.deepseek.com/v1
# DSH_DEEPSEEK_MODEL     deepseek-chat

# ── Sandbox: 本仓库 dev 关掉 (Git Bash 没 bwrap) ─────────────────────────
# DSH_SANDBOX_TYPE=

# ── 当前禁用的功能 (对应后端本机没起; 启用时取消注释即可) ────────────────
#   Temporal cluster:  DSH_TEMPORAL_ADDRESS=localhost:7233 / DSH_TEMPORAL_NAMESPACE=mp-platform
#                     启用: temporal server start-dev --namespace mp-platform
#   OTel collector:    DSH_OTEL_ENDPOINT=http://localhost:4318
#                     启用: 起 collector (runbooks 里有 docker compose)
#   Realtime:          DSH_REALTIME_URL=ws://localhost:4000/realtime/v1/websocket
#                     启用: supabase status (容器应在 running)

# ── 端口规则 (cli flag 决定, dsh 不读 DSH_PORT env) ──────────────────────
#   3080  ← dsh 日常 dsh (你个人 scratchpad, 原生不带 supabase)
#   5173  ← MP-V6 dev dsh (本仓库; vendor/bundle/web-app/cordis.patch.yml:126 兜底 + --port 5173)
#   5173/3080 两套并存互不打扰: 端口不同 + 后端栈不同 (3080 是 dsh 原生, 5173 走本地 Supabase)
