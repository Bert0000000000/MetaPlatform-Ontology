# MP-V6 dsh-web 本机开发配置
#
# 复制到 vendor/deepseek-harness/.env (或 vendor/deepseek-harness/dev.env)
# 然后: cd vendor/deepseek-harness && pnpm dsh web --port 5173
#
# 所有 v6.0 服务连本机 Supabase local

# ===== dsh runtime =====
# DSH_PORT=5173   REMINDER ONLY: dsh 不读 env,端口由 'dsh web --port 5173' 决定;此处
#                 与 vendor/.../cordis.patch.yml 的兜底保持同步避免漂移(5173 是 dev-only)
DSH_HOME=./.dsh-data
DSH_CACHE=./.dsh-cache
DSH_CONFIG=./.dsh-config

# ===== Supabase local =====
# Kong API gateway (db password = 'postgres', port 54321)
DSH_SUPABASE_URL=http://localhost:54321
DSH_SUPABASE_KEY=<service_role_key_from_supabase_status>
DSH_SUPABASE_ANON_KEY=<anon_key_from_supabase_status>

# Postgres direct (port 54322)
DSH_PG_HOST=localhost
DSH_PG_PORT=54322
DSH_PG_USER=postgres
DSH_PG_PASSWORD=postgres
DSH_PG_DATABASE=postgres
DSH_PG_SCHEMA=public

# ===== Temporal =====
DSH_TEMPORAL_ADDRESS=localhost:7233
DSH_TEMPORAL_NAMESPACE=mp-platform

# ===== LLM provider =====
DSH_LLM_PROVIDER=deepseek-primary
DSH_DEEPSEEK_API_KEY=<your_deepseek_api_key>
DSH_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DSH_DEEPSEEK_MODEL=deepseek-chat

# Fallback (optional)
DSH_OPENAI_API_KEY=<your_openai_key>
DSH_OPENAI_BASE_URL=https://api.openai.com/v1
DSH_OPENAI_MODEL=gpt-4o-mini

# ===== Observability =====
DSH_OTEL_ENDPOINT=http://localhost:4318
DSH_OTEL_SERVICE_NAME=mp-dsh-web
DSH_OTEL_SAMPLING=parentbased_traceidratio
DSH_OTEL_SAMPLING_RATIO=1.0

# ===== Sandbox =====
DSH_SANDBOX_TYPE=landlock
DSH_SANDBOX_BWRAP_PATH=/usr/bin/bwrap

# ===== Digital employee presets =====
DSH_PRESET_DEFAULT=knowledge-curator
DSH_PRESETS_PATH=./apps/dsh-presets

# ===== Realtime =====
DSH_REALTIME_URL=ws://localhost:4000/realtime/v1/websocket
DSH_REALTIME_ANON_KEY=<anon_key>

# ===== Logging =====
DSH_LOG_LEVEL=info
DSH_LOG_FORMAT=json
NODE_ENV=development