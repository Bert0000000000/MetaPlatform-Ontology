{
  "title": "MP Temporal Workflow Health",
  "uid": "mp-temporal",
  "tags": ["mp", "v6.0", "temporal", "workflow"],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "title": "Workflow Start Rate (per minute)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "targets": [
        { "expr": "sum by (workflow_type) (rate(temporal_workflow_start_count{platform.mp=\"v6.0\"}[5m])) * 60", "legendFormat": "{{workflow_type}}" }
      ]
    },
    {
      "id": 2,
      "title": "Workflow End Rate (per minute)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "targets": [
        { "expr": "sum by (workflow_type, close_status) (rate(temporal_workflow_end_count{platform.mp=\"v6.0\"}[5m])) * 60", "legendFormat": "{{workflow_type}} {{close_status}}" }
      ]
    },
    {
      "id": 3,
      "title": "Task Queue Latency P50/P95/P99 (ms)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum by (le, task_queue) (rate(temporal_task_queue_latency_bucket{platform.mp=\"v6.0\"}[5m])))", "legendFormat": "{{task_queue}} p50" },
        { "expr": "histogram_quantile(0.95, sum by (le, task_queue) (rate(temporal_task_queue_latency_bucket{platform.mp=\"v6.0\"}[5m])))", "legendFormat": "{{task_queue}} p95" },
        { "expr": "histogram_quantile(0.99, sum by (le, task_queue) (rate(temporal_task_queue_latency_bucket{platform.mp=\"v6.0\"}[5m])))", "legendFormat": "{{task_queue}} p99" }
      ],
      "fieldConfig": { "defaults": { "unit": "ms" } }
    },
    {
      "id": 4,
      "title": "Activity Failure Rate",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "targets": [
        { "expr": "sum by (activity_type) (rate(temporal_activity_failure_count{platform.mp=\"v6.0\"}[5m])) / sum by (activity_type) (rate(temporal_activity_start_count{platform.mp=\"v6.0\"}[5m]))", "legendFormat": "{{activity_type}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "percentunit" } }
    },
    {
      "id": 5,
      "title": "Long-running Workflows (>1h)",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "x": 0, "y": 16, "w": 12, "h": 8 },
      "targets": [
        { "expr": "count(temporal_workflow_running_count{platform.mp=\"v6.0\"} > 3600)" }
      ]
    },
    {
      "id": 6,
      "title": "Shard Lag (P99)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "x": 12, "y": 16, "w": 12, "h": 8 },
      "targets": [
        { "expr": "temporal_history_shard_lag_p99{platform.mp=\"v6.0\"}", "legendFormat": "{{shard_id}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 10 }, { "color": "red", "value": 30 }] } } }
    }
  ]
}